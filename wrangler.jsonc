{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "filtbo",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/.netlify/functions/*"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
